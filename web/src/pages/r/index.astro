---
import '../../styles/global.css';
import Head from '../../components/Head.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import Report from '../../islands/Report.tsx';
---

<!doctype html>
<html lang="en">
  <head
    ><Head
      title="Website security report | WebSec0"
      description="TLS configuration, certificate and HTTP security header observations from your WebSec0 scan."
      report
    /></head
  >
  <body class="report-page">
    <SiteHeader report />
    <main class="page" id="main">
      <Report client:only="preact" />
      <noscript
        ><div class="card">
          <div class="card-body">
            Enable JavaScript to load this report. <a href="/"
              >Return to WebSec0</a
            >.
          </div>
        </div></noscript
      >
    </main>
    <footer class="report-footer">
      WebSec0 · Observations at scan time. Grades describe configuration within
      the checks performed.
    </footer>
  </body>
</html>
