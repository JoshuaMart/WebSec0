---
import '../styles/global.css';
import '../styles/landing.css';
import Head from '../components/Head.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SecurityIllustration from '../components/SecurityIllustration.astro';
const title = 'Website Security Checker — SSL/TLS & HTTP Headers | WebSec0';
const description =
  'Check SSL/TLS, certificates and HTTP security headers. Get clear grades and actionable findings with WebSec0, a free, open-source website security checker.';
const faqs = [
  {
    question: 'What does this website security checker test?',
    answer:
      'WebSec0 checks a hostname’s TLS protocols, cipher suites, certificate chain and HTTP security headers. It also reports security.txt, robots.txt and, where available, SPF and DMARC DNS policies. TLS and HTTP headers receive separate grades; the other observations are informational.',
  },
  {
    question: 'How do I check my SSL certificate and TLS configuration?',
    answer:
      'Enter your domain above and run a scan. The report shows the certificate chain, hostname validation, expiration, supported protocols and cipher suites. Open the Certificate, Protocols and Ciphers tabs for the underlying observations.',
  },
  {
    question: 'Which HTTP security headers are checked?',
    answer:
      'The headers grade covers Strict-Transport-Security (HSTS), Content-Security-Policy (CSP), X-Frame-Options, X-Content-Type-Options, Referrer-Policy and Permissions-Policy. Additional observations include cross-origin policies, server information and cookie attributes.',
  },
  {
    question: 'Does an A grade mean my website is completely secure?',
    answer:
      'No. A grade describes the configuration observed at the time of the scan, within the checks performed. WebSec0 does not test application logic, authentication or all possible vulnerabilities. Weakness findings are configuration-based indicators, not proof of exploitability. Incomplete checks remain marked in the report.',
  },
  {
    question: 'Are my scan results public?',
    answer:
      'Scans are not listed in public history unless you select “Include in public history”. An unlisted report is still accessible to anyone with its report link while it remains cached. Unlisted does not mean access-controlled.',
  },
  {
    question: 'Is WebSec0 free and open source?',
    answer:
      'Yes. WebSec0 is MIT-licensed and the hosted scanner requires no account. You can inspect the source, self-host the application or use the JSON API. Request limits apply to protect the service.',
  },
];
const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebSite',
      '@id': `${Astro.site}#website`,
      name: 'WebSec0',
      url: Astro.site,
      inLanguage: 'en',
    },
    {
      '@type': 'WebApplication',
      name: 'WebSec0',
      url: Astro.site,
      description,
      applicationCategory: 'SecurityApplication',
      operatingSystem: 'Any',
      isAccessibleForFree: true,
      license: 'https://opensource.org/license/mit',
      sameAs: 'https://github.com/JoshuaMart/WebSec0',
      featureList: [
        'SSL/TLS configuration checks',
        'Certificate chain inspection',
        'HTTP security header grades',
        'SPF and DMARC observations',
      ],
      offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
    },
    {
      '@type': 'FAQPage',
      mainEntity: faqs.map(({ question, answer }) => ({
        '@type': 'Question',
        name: question,
        acceptedAnswer: { '@type': 'Answer', text: answer },
      })),
    },
  ],
};
---

<!doctype html>
<html lang="en">
  <head>
    <Head title={title} description={description} />
    <script
      type="application/ld+json"
      set:html={JSON.stringify(schema).replace(/</g, '\\u003c')}
    />
  </head>
  <body class="landing">
    <SiteHeader />
    <main id="main">
      <section class="hero" aria-labelledby="hero-title">
        <div class="hero-copy">
          <p class="eyebrow">
            <span class="status-dot" aria-hidden="true"></span> Free website security
            checker
          </p>
          <h1 id="hero-title">
            Your website’s<br />security, <span>in focus.</span>
          </h1>
          <p class="lede">
            A clearer picture of your website’s security configuration. Check
            SSL/TLS, certificates and HTTP headers. Know what’s working. See
            what needs attention.
          </p>
          <div class="scan-area" id="scan">
            <form id="scanForm" autocomplete="off">
              <label class="input-label" for="hostInput"
                >Check your domain</label
              >
              <div class="scan-field">
                <svg
                  width="20"
                  height="20"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.5"
                  aria-hidden="true"
                  ><circle cx="12" cy="12" r="9"></circle><ellipse
                    cx="12"
                    cy="12"
                    rx="4"
                    ry="9"></ellipse><path d="M3 12h18"></path></svg
                >
                <input
                  id="hostInput"
                  name="host"
                  type="text"
                  placeholder="your-domain.com"
                  spellcheck="false"
                  autocapitalize="off"
                  inputmode="url"
                  aria-describedby="scanHint"
                  required
                />
                <button type="submit" class="btn btn-primary" id="scanButton"
                  ><span id="scanButtonLabel">Scan website</span><span
                    aria-hidden="true">↗</span
                  ></button
                >
              </div>
              <p id="scanHint" class="input-hint">
                Free to use. No account needed.
              </p>
              <label class="opt-public"
                ><input type="checkbox" id="listInHistory" /><span
                  >Include in public history</span
                ></label
              >
              <p class="privacy-note">
                Unlisted by default. Anyone with the report link can view it.
              </p>
            </form>
            <div class="scan-feedback" id="validating" role="status" hidden>
              <span class="spinner" aria-hidden="true"></span><span
                id="validatingText">Scanning…</span
              >
            </div>
            <div class="scan-error" id="errorBox" role="alert" hidden></div>
            <noscript
              ><p class="scan-error">
                Enable JavaScript to run a scan and view interactive reports.
                The check descriptions below are available without it.
              </p></noscript
            >
          </div>
        </div>
        <div class="hero-visual">
          <div class="visual-heading">
            <span class="micro-label">A look beneath the surface</span>
          </div>
          <SecurityIllustration />
          <div class="sample-report" id="report-preview">
            <div class="sample-top">
              <span class="mono">example.com</span><span class="sample-label"
                >Illustrative report</span
              >
            </div>
            <div class="sample-grades">
              <div>
                <span class="sample-grade">A</span><span
                  ><strong>TLS configuration</strong><small
                    >Protocols & certificates</small
                  ></span
                >
              </div>
              <div>
                <span class="sample-grade sample-grade-warn">B</span><span
                  ><strong>HTTP headers</strong><small
                    >Browser protections</small
                  ></span
                >
              </div>
            </div>
            <div class="sample-finding">
              <span class="finding-dot" aria-hidden="true"></span><span
                >Understand the finding. Find the next step.</span
              ><span aria-hidden="true">↗</span>
            </div>
          </div>
          <p class="visual-caption">
            Separate grades. A more useful perspective.
          </p>
        </div>
      </section>

      <div class="capability-strip" aria-label="Scan coverage">
        <span>One domain. Multiple layers.</span><ul>
          <li>SSL / TLS</li><li>Certificates</li><li>HTTP headers</li><li>
            SPF / DMARC
          </li>
        </ul>
      </div>

      <section
        class="coverage section-space"
        id="coverage"
        aria-labelledby="coverage-title"
      >
        <div class="section-heading">
          <div>
            <p class="eyebrow">01 / The checks</p><h2 id="coverage-title">
              Small details.<br />Real security implications.
            </h2>
          </div><p>
            Move from an unexplained score to specific observations. Each layer
            gives you another part of the picture.
          </p>
        </div>
        <div class="coverage-grid">
          <article class="coverage-item">
            <span class="check-number">01</span><h3>
              SSL & TLS configuration
            </h3><p>
              See which protocols and cipher suites your server accepts, from
              legacy SSL to TLS 1.3. Identify outdated options and
              configuration-based weakness indicators.
            </p><div class="check-tags">
              <span>Protocols</span><span>Cipher suites</span><span
                >Forward secrecy</span
              >
            </div>
          </article>
          <article class="coverage-item">
            <span class="check-number">02</span><h3>Certificate health</h3><p>
              Inspect the certificate chain, browser trust, hostname match and
              expiration. Look into OCSP stapling and certificate transparency
              observations.
            </p><div class="check-tags">
              <span>Trust chain</span><span>Expiration</span><span>OCSP</span>
            </div>
          </article>
          <article class="coverage-item">
            <span class="check-number">03</span><h3>HTTP security headers</h3><p
            >
              Check HSTS, Content-Security-Policy and other browser protections.
              Get a dedicated headers grade with the observations behind it.
            </p><div class="check-tags">
              <span>HSTS</span><span>CSP</span><span>Permissions-Policy</span>
            </div>
          </article>
          <article class="coverage-item">
            <span class="check-number">04</span><h3>
              The surrounding signals
            </h3><p>
              Review security.txt and robots.txt, plus SPF and DMARC policies
              where available. These add context without changing your TLS or
              headers grades.
            </p><div class="check-tags">
              <span>security.txt</span><span>SPF / DMARC</span><span
                >Informational</span
              >
            </div>
          </article>
        </div>
        <a class="text-link catalog-link" href="/api/v1/checks"
          >Explore the full check catalog <span aria-hidden="true">↗</span></a
        >
      </section>

      <section
        class="workflow section-space"
        id="how-it-works"
        aria-labelledby="workflow-title"
      >
        <div class="section-heading">
          <div>
            <p class="eyebrow">02 / From scan to understanding</p><h2
              id="workflow-title"
            >
              Less guesswork.<br />A clearer next step.
            </h2>
          </div><p>
            Built for developers, site owners and anyone responsible for a
            website’s configuration.
          </p>
        </div>
        <p class="workflow-demo-label">Illustrative workflow</p>
        <ol class="workflow-steps">
          <li>
            <div class="step-visual" aria-hidden="true">
              <span class="demo-caption">01 / Domain</span>
              <div class="demo-domain">
                <span>example.com</span><span class="demo-submit">↗</span>
              </div>
              <div class="demo-checks">
                <span>TLS</span><span>HTTP</span><span>DNS</span>
              </div>
              <div class="demo-track"><span class="demo-progress"></span></div>
            </div><h3>Start with a domain</h3><p>
              Enter your hostname. WebSec0 makes TLS connections, HTTP requests
              and DNS queries to inspect its configuration.
            </p>
          </li>
          <li>
            <div class="step-visual" aria-hidden="true">
              <span class="demo-caption">02 / Report</span>
              <div class="demo-results demo-reveal">
                <div><span class="demo-grade">A</span><span>TLS</span></div>
                <div>
                  <span class="demo-grade demo-grade-warn">B</span><span
                    >Headers</span>
                </div>
              </div>
              <div class="demo-observation demo-reveal">
                <span class="finding-dot"></span> Review the header findings
              </div>
            </div><h3>Read the evidence</h3><p>
              Review separate TLS and headers grades. Go deeper with certificate
              details, header values and clearly marked incomplete checks.
            </p>
          </li>
          <li>
            <div class="step-visual" aria-hidden="true">
              <span class="demo-caption">03 / Your next step</span>
              <div class="demo-actions">
                <span class="demo-action"
                  ><span>01</span> Read the remediation</span
                >
                <span class="demo-action"
                  ><span>02</span> Update your configuration</span
                >
                <span class="demo-action"
                  ><span>03</span> Check the domain again <span
                    class="demo-return">↗</span
                  ></span
                >
              </div>
            </div><h3>Make an informed change</h3><p>
              Use findings and the remediation catalog to plan your fixes. Run
              another check after updating your configuration.
            </p>
          </li>
        </ol>
        <p class="scope-note">
          <span aria-hidden="true">ⓘ</span> A configuration check is one part of
          security. It does not replace an application security assessment.
        </p>
      </section>

      <section
        class="recent section-space"
        id="recent"
        hidden
        aria-labelledby="recent-title"
      >
        <div class="recent-head">
          <div>
            <p class="eyebrow">Community activity</p><h2 id="recent-title">
              Recently checked.
            </h2>
          </div><span>Shared by choice.</span>
        </div><div class="recent-grid" id="recentGrid"></div>
      </section>

      <section
        class="developer-section section-space"
        aria-labelledby="developer-title"
      >
        <div>
          <p class="eyebrow">Open by design</p><h2 id="developer-title">
            Your workflow.<br />Your infrastructure.
          </h2><p>
            Use the JSON API, inspect the checks or run your own instance. The
            same transparent engine, wherever you need it.
          </p><div class="developer-links">
            <a
              href="https://github.com/JoshuaMart/WebSec0/blob/main/skills/websec0/references/api.md"
              class="btn"
              >Read the API guide <span aria-hidden="true">↗</span></a
            ><a
              class="text-link"
              href="https://github.com/JoshuaMart/WebSec0#readme"
              >Self-host WebSec0 <span aria-hidden="true">↗</span></a
            >
          </div>
        </div><div class="api-preview">
          <div class="api-preview-head">
            <span class="status-dot" aria-hidden="true"></span> Structured. Readable.
            Ready to use.
          </div><dl>
            <div><dt>Report format</dt><dd>JSON</dd></div><div>
              <dt>Independent grades</dt><dd>TLS + Headers</dd>
            </div><div>
              <dt>Check catalog</dt><dd>Findings + remediation</dd>
            </div><div><dt>Source license</dt><dd>MIT</dd></div>
          </dl>
        </div>
      </section>

      <section class="faq section-space" id="faq" aria-labelledby="faq-title">
        <div>
          <p class="eyebrow">A few useful answers</p><h2 id="faq-title">
            Know what<br />you’re checking.
          </h2>
        </div><div class="faq-list">
          {
            faqs.map(({ question, answer }) => (
              <details>
                <>
                  <summary>
                    {question}
                    <span class="faq-plus" aria-hidden="true">
                      +
                    </span>
                  </summary>
                  <p>{answer}</p>
                </>
              </details>
            ))
          }
        </div>
      </section>
      <section class="closing">
        <div>
          <p class="eyebrow">Clarity starts with a check</p><h2>
            Take a closer look.
          </h2>
        </div><a class="btn btn-primary" href="#scan"
          >Check your website <span aria-hidden="true">↗</span></a
        >
      </section>
    </main>
    <footer class="landing-footer">
      <div>
        <a href="/" class="brand">websec0</a><p>
          A clearer view of web security.
        </p>
      </div><nav aria-label="Footer">
        <a href="#faq">FAQ</a><a href="/api/v1/checks">Check catalog</a><a
          href="https://github.com/JoshuaMart/WebSec0">Source code ↗</a
        ><a href="https://github.com/JoshuaMart/WebSec0/blob/main/LICENSE"
          >MIT license</a
        >
      </nav>
    </footer>
    <script>
      import '../scripts/landing.ts';
    </script>
  </body>
</html>
